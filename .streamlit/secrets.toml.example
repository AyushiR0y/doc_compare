# Copy this file to .streamlit/secrets.toml and fill in the values.
#
#   cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#
# secrets.toml is git-ignored and must stay that way — it holds a live
# credential. This .example file is committed and must never hold a real one.
#
# All three are optional. Leave MIS_EMAIL_TO empty (or unset) and the app runs
# normally with MIS reporting switched off — which is what you want locally,
# so test comparisons don't mail anyone.

# Gmail account the MIS report is sent from.
GMAIL_USERNAME = "you@example.com"

# A Gmail App Password, not the account password.
# Google Account -> Security -> 2-Step Verification -> App passwords
GMAIL_APP_PASSWORD = "your-16-character-app-password"

# Comma-separated recipients. Empty means nothing is sent.
MIS_EMAIL_TO = ""
